{
    "name": "visit-flow-backend",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "db:setup": "prisma migrate deploy && prisma generate",
        "db:seed": "node prisma/seed.js",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@prisma/client": "6.19.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^5.1.0",
        "express-validator": "^7.2.1",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "prettier": "^3.6.2",
        "prisma": "6.19.0",
        "supertest": "^7.1.4",
        "vitest": "^3.2.6"
    }
}
